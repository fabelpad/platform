# Dit zijn de enige vier GitHub repositoryvariables voor de webdeployroute.
# Kopieer voor lokale ontwikkeling naar .env.local. Geen echte secrets committen.
FABELPAD_APP_ORIGIN=http://localhost:3000
# local gebruikt uitsluitend lokale gegevens en vereist lege Supabase-waarden.
# supabase vereist beide onderstaande waarden en valt bij een fout nooit terug.
FABELPAD_DATA_MODE=local

# Publiek: deze waarden worden tijdens next build in de browserbundel verwerkt.
# Vul beide in voor echte gezinsdata; gebruik nooit een secret/service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Hostbeheer bepaalt deze optionele runtimeflags, niet GitHub repositoryvariables.
# Pas activeren nadat provider, callbacks en de bestaande DG-mailgateway werken.
FABELPAD_AUTH_EMAIL_ENABLED=false
FABELPAD_AUTH_GOOGLE_ENABLED=false

# De releaseroute bepaalt deze metadata automatisch; niet handmatig in GitHub.
# Lokaal is geen geverifieerde release-identiteit nodig.
FABELPAD_DEPLOY_ENV=local
FABELPAD_RELEASE_SHA=

# Geen service-role key, Resend-key, deploycredential, signingsecret of keystore
# is nodig in de huidige Next.js-runtime. Toekomstige Edge-/worker-secrets worden
# pas benoemd zodra het bestaande DG-contract is vastgesteld: docs/INRICHTING.md.
