# Lokaal bouwen en de demo gebruiken kan zonder Supabase. Kopieer naar .env.local.
# Dit zijn namen en lege voorbeeldwaarden, nooit echte secrets committen.
FABELPAD_DEPLOY_ENV=local
APP_URL=http://localhost:3000

# Publiek: deze waarden worden tijdens next build in de browserbundel verwerkt.
# Vul beide in voor echte gezinsdata; gebruik nooit een secret/service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Pas activeren nadat provider, callbacks en de bestaande DG-mailgateway werken.
FABELPAD_AUTH_EMAIL_ENABLED=false
FABELPAD_AUTH_GOOGLE_ENABLED=false

# In staging/production verplicht: de volledige, exact uitgecheckte broncommit.
# Lokaal leeg betekent geen geverifieerde release-identiteit.
FABELPAD_RELEASE_SHA=

# Geen service-role key, Resend-key, deploycredential, signingsecret of keystore
# is nodig in de huidige Next.js-runtime. Toekomstige Edge-/worker-secrets worden
# pas benoemd zodra het bestaande DG-contract is vastgesteld: docs/INRICHTING.md.
