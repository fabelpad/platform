# Niet-geheime productiegegevens. Openbare bereikbaarheid vóór indiening verifiëren.
FABELPAD_VARIANT=production
FABELPAD_ANDROID_PACKAGE=nl.fabelpad.app
FABELPAD_ANDROID_VERSION_NAME=1.0.0
FABELPAD_ANDROID_VERSION_CODE=1
FABELPAD_ANDROID_ICON=./assets/brand/launcher.png
FABELPAD_PRIVACY_URL=https://fabelpad.nl/privacy
FABELPAD_SUPPORT_URL=mailto:support@fabelpad.nl
# Signing gebruikt afgeschermde bestanden buiten repository/artefacten.
# Nooit keystores, wachtwoorden of Google service-account-JSON hier zetten.
# FABELPAD_UPLOAD_KEYSTORE=
# FABELPAD_UPLOAD_KEY_ALIAS=
# FABELPAD_UPLOAD_STORE_PASSWORD_FILE=
# FABELPAD_UPLOAD_KEY_PASSWORD_FILE=

# Gekoppelde upgrade: aparte expliciete build, nooit stilzwijgend activeren.
# FABELPAD_VARIANT=connected
# FABELPAD_ANDROID_VERSION_CODE=3
# FABELPAD_CONNECTED_ENVIRONMENT=staging
# FABELPAD_CONNECTED_ORIGIN=https://staging.fabelpad.nl
# FABELPAD_CONNECTED_SUPABASE_URL=https://<stagingproject>.supabase.co
# FABELPAD_CONNECTED_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
