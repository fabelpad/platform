# Copy to runtime-configs/<config-id>/<full-source-SHA>.env below the own configRoot.
# Directory root:app-fab-nxt-stg 0750, file root:app-fab-nxt-stg 0640.
# Use exactly the same five public/server values as that config-id's build file.
# The source SHA is the approved full SHA, not the control workflow's checkout.
APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
FABELPAD_AUTH_EMAIL_ENABLED=false
FABELPAD_AUTH_GOOGLE_ENABLED=false
FABELPAD_DEPLOY_ENV=staging
FABELPAD_RELEASE_SHA=
PORT=4176
