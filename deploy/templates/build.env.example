# Copy to /etc/dg-webservices/fabelpad-nxttrack-staging/build-configs/<config-id>.env
# root:build-fab-nxt-stg 0640. Never put server secrets in this file.
# All names below must be filled with the NEW staging project's own values.
APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
FABELPAD_AUTH_EMAIL_ENABLED=false
FABELPAD_AUTH_GOOGLE_ENABLED=false
