# Prepared only. The installer does not register, install, start or enable it.
# First verify repository scope and selected-workflow restrictions in GitHub.
[Unit]
Description=Fabelpad dedicated production GitHub runner
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/actions-runner/fabelpad-vps08-production/.runner

[Service]
Type=simple
User=run-fab-v08-prd
Group=run-fab-v08-prd
WorkingDirectory=/opt/actions-runner/fabelpad-vps08-production
ExecStart=/opt/actions-runner/fabelpad-vps08-production/runsvc.sh
Restart=on-failure
RestartSec=5s
UMask=0077
KillMode=control-group
TimeoutStopSec=120s

[Install]
WantedBy=multi-user.target
