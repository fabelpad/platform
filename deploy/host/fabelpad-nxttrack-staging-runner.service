# Prepared only. The installer does not register, install, start or enable it.
# First verify repository scope and selected-workflow restrictions in GitHub.
[Unit]
Description=Fabelpad dedicated staging GitHub runner
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/actions-runner/fabelpad-nxttrack-staging/.runner

[Service]
Type=simple
User=run-fab-nxt-stg
Group=run-fab-nxt-stg
WorkingDirectory=/opt/actions-runner/fabelpad-nxttrack-staging
ExecStart=/opt/actions-runner/fabelpad-nxttrack-staging/runsvc.sh
Restart=on-failure
RestartSec=5s
UMask=0077
KillMode=control-group
TimeoutStopSec=120s

[Install]
WantedBy=multi-user.target
