{
  "name": "fabelpad",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.18.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "check:config": "node scripts/config-check.mjs",
    "check:content": "node scripts/local-checks.mjs && node scripts/legal-check.mjs",
    "check:profiles": "node --experimental-strip-types scripts/profile-storage-check.mjs",
    "content:export": "node scripts/export-native-content.mjs",
    "test:browser": "playwright test",
    "check:backend": "node scripts/supabase-db-check.mjs && node scripts/supabase-contract-check.mjs && node scripts/parent-api-check.mjs && node scripts/lifecycle-db-check.mjs && node --test scripts/lifecycle-worker.test.mjs && node scripts/privacy-admin-api-check.mjs && node scripts/lifecycle-scheduler-db-check.mjs",
    "check:email": "node scripts/email/export-templates.mjs --check && node --test scripts/email/*.test.mjs && node scripts/email/settings-db-check.mjs && python3 -B scripts/email/configure-supabase-mail.test.py",
    "check:native": "node scripts/native-runtime-check.mjs",
    "check:deploy": "node --test scripts/deploy/*.test.mjs && python3 -B scripts/deploy/install-host.test.py"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "5.2.8",
    "@fontsource-variable/nunito": "5.2.7",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0"
}
